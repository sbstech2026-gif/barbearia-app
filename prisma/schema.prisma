generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Agendamento {
  id              String   @id @default(uuid())
  servicoId       String
  servicoNome     String
  preco           Float
  barbeiroId      String
  barbeiroNome    String
  data            String   // Formato YYYY-MM-DD
  horario         String   // Formato HH:MM
  clienteNome     String
  clienteWhatsapp String
  criadoEm        DateTime @default(now())
}